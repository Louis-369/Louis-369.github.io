---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const allPhotos = await getCollection('photos', ({ data }) => !data.draft);
const photos = allPhotos.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const photosData = photos.map((item, index) => ({
  index,
  src: item.data.photo,
  title: item.data.title,
  location: item.data.location,
  date: item.data.pubDate.toISOString().slice(0, 10),
  meta: item.data.meta || '',
  exif: item.data.exif || '',
}));
---

<BaseLayout 
  title="Photo Log — Visual Journal & Micro-Thoughts | Louis."
  description="A quiet visual log capturing architectural geometry, twilight moods, and tactile urban moments."
  currentNav="photos"
>
  <main class="subpage-container">
    <header class="subpage-header">
      <div class="subpage-eyebrow">VISUAL CHRONICLE</div>
      <h1 class="subpage-title">Photo Log</h1>
      <p class="subpage-subtitle">
        生活切片、幾何結構與微光觀察。每張照片搭配一小段當下的思緒沉澱。
      </p>
    </header>

    <div class="photos-feed">
      {photos.map(async (item, index) => {
        const { Content } = await render(item);
        const isPortrait = item.data.aspectRatio === '3:4' || item.data.aspectRatio === '4:5' || item.data.aspectRatio === '9:16';
        return (
          <article class="photo-item" data-photo-card data-index={index}>
            <div class="photo-frame-wrap" data-gallery-trigger data-index={index}>
              <img 
                src={item.data.photo} 
                alt={item.data.title} 
                class:list={["photo-img", { "is-portrait": isPortrait }]}
                loading="lazy" 
              />
            </div>
            <div class="photo-info-bar">
              <div class="photo-info-left">
                <span>{item.data.location} · {item.data.pubDate.toISOString().slice(0, 10)}</span>
                {item.data.meta && <span class="photo-meta-tag">{item.data.meta}</span>}
              </div>
              {item.data.exif && (
                <span class="photo-exif-pill">📷 {item.data.exif}</span>
              )}
            </div>
            <div class="photo-caption-body">
              <Content />
            </div>
          </article>
        );
      })}
    </div>
  </main>

  <!-- Photo Gallery Lightbox Modal -->
  <div id="photo-gallery-lightbox" class="editorial-lightbox-overlay" role="dialog" aria-modal="true" aria-hidden="true" tabindex="-1">
    <button class="lightbox-close-btn" id="photo-lb-close" aria-label="Close Lightbox">ESC ✕</button>
    <button class="lightbox-nav-arrow is-prev" id="photo-lb-prev" aria-label="Previous photo">‹</button>
    <button class="lightbox-nav-arrow is-next" id="photo-lb-next" aria-label="Next photo">›</button>
    <div class="lightbox-content-box" id="photo-lb-box">
      <img src="" alt="" class="lightbox-img" id="photo-lb-img" />
      <div class="lightbox-caption-bar" id="photo-lb-caption">
        <span id="photo-lb-counter"></span>
        <span id="photo-lb-title"></span>
        <span id="photo-lb-exif" class="photo-exif-pill" style="display: none;"></span>
      </div>
    </div>
  </div>

  <script id="photos-json" type="application/json" set:html={JSON.stringify(photosData)} />

  <script>
    interface PhotoItem {
      index: number;
      src: string;
      title: string;
      location: string;
      date: string;
      meta?: string;
      exif?: string;
    }

    function setupPhotoGallery() {
      const dataEl = document.getElementById('photos-json');
      if (!dataEl) return;
      
      let items: PhotoItem[] = [];
      try {
        items = JSON.parse(dataEl.textContent || '[]');
      } catch (e) {
        console.error('Failed to parse photo gallery data', e);
        return;
      }
      if (!items.length) return;

      const lightbox = document.getElementById('photo-gallery-lightbox');
      const lbImg = document.getElementById('photo-lb-img') as HTMLImageElement | null;
      const lbBox = document.getElementById('photo-lb-box');
      const lbClose = document.getElementById('photo-lb-close');
      const lbPrev = document.getElementById('photo-lb-prev');
      const lbNext = document.getElementById('photo-lb-next');
      const lbCounter = document.getElementById('photo-lb-counter');
      const lbTitle = document.getElementById('photo-lb-title');
      const lbExif = document.getElementById('photo-lb-exif');

      if (!lightbox || !lbImg) return;

      const activeLightbox = lightbox;
      const activeImg = lbImg;
      let currentIndex = 0;

      function updatePhoto(index: number) {
        if (index < 0) index = items.length - 1;
        if (index >= items.length) index = 0;
        currentIndex = index;

        const photo = items[currentIndex];
        if (!photo) return;

        activeImg.src = photo.src;
        activeImg.alt = photo.title;

        if (lbCounter) lbCounter.textContent = `[ ${currentIndex + 1} / ${items.length} ]`;
        if (lbTitle) lbTitle.textContent = `${photo.title} · ${photo.location} (${photo.date})`;
        
        if (lbExif) {
          if (photo.exif) {
            lbExif.textContent = `📷 ${photo.exif}`;
            lbExif.style.display = 'inline-flex';
          } else {
            lbExif.style.display = 'none';
          }
        }
      }

      function openLightbox(index: number) {
        updatePhoto(index);
        activeLightbox.classList.add('is-open');
        activeLightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        activeLightbox.classList.remove('is-open');
        activeLightbox.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      // Triggers on each photo frame
      const triggers = document.querySelectorAll('[data-gallery-trigger]');
      triggers.forEach((trigger) => {
        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          const idx = parseInt(trigger.getAttribute('data-index') || '0', 10);
          openLightbox(idx);
        });
      });

      // Navigation & Close handlers
      lbClose?.addEventListener('click', (e) => {
        e.stopPropagation();
        closeLightbox();
      });

      lbPrev?.addEventListener('click', (e) => {
        e.stopPropagation();
        updatePhoto(currentIndex - 1);
      });

      lbNext?.addEventListener('click', (e) => {
        e.stopPropagation();
        updatePhoto(currentIndex + 1);
      });

      // Close when clicking backdrop outside content box
      activeLightbox.addEventListener('click', (e) => {
        if (lbBox && !lbBox.contains(e.target as Node) && e.target !== lbPrev && e.target !== lbNext) {
          closeLightbox();
        }
      });

      // Keyboard navigation: Escape, ArrowLeft, ArrowRight
      window.addEventListener('keydown', (e) => {
        if (!activeLightbox.classList.contains('is-open')) return;

        if (e.key === 'Escape') {
          closeLightbox();
        } else if (e.key === 'ArrowLeft') {
          updatePhoto(currentIndex - 1);
        } else if (e.key === 'ArrowRight') {
          updatePhoto(currentIndex + 1);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupPhotoGallery);
    } else {
      setupPhotoGallery();
    }
  </script>
</BaseLayout>
