---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 2);

const allPhotos = await getCollection('photos', ({ data }) => !data.draft);
const latestPhotos = allPhotos.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 2);
---

<BaseLayout isHome={true} currentNav="works">
  <main class="main-wrapper">
    <!-- Hero Section (Unified Single-Container Architecture) -->
    <section class="hero-section" id="hero">
      <!-- Layer 1: Warm Paper Canvas Base Background -->
      <div class="hero-paper-bg"></div>

      <!-- Layer 2: Hero Content (Louis. Title with Self-Contained Magnetic Black Hole Dot) -->
      <div class="hero-content-wrap">
        <div class="hero-title-container">
          <h1 class="hero-title-line" id="hero-title-line">
            <span class="js-grav-text">Louis</span>
            <div class="magnetic-wrap" id="hero-magnetic-wrap">
              <div class="js-magnetic-area magnetic-size" id="hero-magnetic-area" title="Click to trigger Black Hole"></div>
              <div class="js-magnetic-content" id="hero-magnetic-content">
                <span class="bh-dot-core" id="hero-title-dot"></span>
                <canvas class="bh-shader-canvas" id="hero-bh-canvas"></canvas>
              </div>
            </div>
          </h1>
        </div>

        <!-- Dictionary Entry Layout (英文字典條目版型) -->
        <div class="hero-dictionary-entry">
          <div class="dict-phonetic-pill">
            <span class="bh-word-particle dict-ipa">/ˈluː.ɪs/</span>
            <span class="bh-word-particle dict-divider">·</span>
            <span class="bh-word-particle dict-pos">n.</span>
          </div>
          <p class="dict-def-en">
            <span class="bh-word-particle">A</span>{' '}
            <span class="bh-word-particle">craftsperson</span>{' '}
            <span class="bh-word-particle">architecting</span>{' '}
            <span class="bh-word-particle">digital</span>{' '}
            <span class="bh-word-particle">systems</span>{' '}
            <span class="bh-word-particle">with</span>{' '}
            <span class="bh-word-particle">engineering</span>{' '}
            <span class="bh-word-particle">rigor</span>{' '}
            <span class="bh-word-particle">and</span>{' '}
            <span class="bh-word-particle">editorial</span>{' '}
            <span class="bh-word-particle">aesthetic.</span>
          </p>
          <p class="dict-def-tw">
            <span class="bh-word-particle">以工程之嚴謹</span><span class="bh-word-particle">鑄造系統</span><span class="bh-word-particle">，</span><span class="bh-word-particle">以編排之美感</span><span class="bh-word-particle">傳遞溫度</span><span class="bh-word-particle">。</span>
          </p>
        </div>
      </div>

      <!-- Horizontal Bottom-Left Editorial Scroll Indicator with Pure DOM Dual-Line Corner -->
      <a href="#works" class="hero-scroll-indicator" id="hero-scroll-indicator" aria-label="Scroll Down to Works">
        <div class="scroll-wrap-box">
          <span class="scroll-text">SCROLL DOWN</span>
          <!-- Pure DOM Dual-Bar Tracks (Pure GPU Compositor) -->
          <div class="corner-bar-top-track">
            <div class="corner-bar-top-fill"></div>
          </div>
          <div class="corner-bar-right-track">
            <div class="corner-bar-right-fill"></div>
          </div>
        </div>
      </a>
    </section>

    <!-- Selected Works / Stories Section (bymonolog Paper-Cut Stacking Cards) -->
    <section class="works-section" id="works">
      <header class="section-header-block">
        <div class="section-header-left">
          <div class="section-eyebrow">CASE STUDIES & ARTIFACTS</div>
          <h2 class="section-title section-heading-split">Featured Works</h2>
        </div>
        <div class="section-index-stamp">
          <span>01 — 04</span>
        </div>
      </header>

      <!-- Dynamic Stacking Cards Container (Populated via app.js) -->
      <div class="works-cards-wrap" id="works-cards-container">
        <!-- Populated via app.js -->
      </div>
    </section>

    <!-- NEW Section: Recent Writings (社論文章精選) -->
    <section class="works-section" id="writings" style="padding-top: 5rem;">
      <header class="home-section-header">
        <div class="section-header-left">
          <div class="section-eyebrow">THOUGHTS & ESSAYS</div>
          <h2 class="section-title">Recent Writings</h2>
        </div>
        <a href="/blog/" class="home-section-more-link">
          <span>VIEW ALL ESSAYS</span>
          <span>→</span>
        </a>
      </header>

      <div class="blog-grid">
        {latestPosts.map((post) => (
          <a href={`/blog/${post.id}/`} class="blog-card">
            {post.data.cover && (
              <div class="blog-card-cover-wrap">
                <img src={post.data.cover} alt={post.data.coverAlt || post.data.title} class="blog-card-cover" loading="lazy" />
              </div>
            )}
            <div class="blog-card-meta">
              <span class="blog-card-cat-badge">{post.data.category}</span>
              <span>·</span>
              <span>{post.data.pubDate.toISOString().slice(0, 10)}</span>
            </div>
            <h3 class="blog-card-title">{post.data.title}</h3>
            <p class="blog-card-desc">{post.data.description}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- NEW Section: Recent Snaps (最新攝影切片) -->
    <section class="works-section" id="snaps" style="padding-top: 5rem; padding-bottom: 5rem;">
      <header class="home-section-header">
        <div class="section-header-left">
          <div class="section-eyebrow">VISUAL JOURNAL</div>
          <h2 class="section-title">Recent Snaps</h2>
        </div>
        <a href="/photos/" class="home-section-more-link">
          <span>VIEW ALL PHOTOS</span>
          <span>→</span>
        </a>
      </header>

      <div class="photos-feed" style="gap: 3.5rem;">
        {latestPhotos.map(async (photo) => {
          const { Content } = await render(photo);
          return (
            <article class="photo-item">
              <div class="photo-frame-wrap">
                <img src={photo.data.photo} alt={photo.data.title} class="photo-img" loading="lazy" />
              </div>
              <div class="photo-info-bar">
                <span>{photo.data.location} · {photo.data.pubDate.toISOString().slice(0, 10)}</span>
                {photo.data.meta && <span class="photo-meta-tag">{photo.data.meta}</span>}
              </div>
              <div class="photo-caption-body">
                <Content />
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- Philosophy & About Section (1:1 bymonolog.com Dark Tactile Matrix) -->
    <section class="about-section is-dark-surface" id="about">
      <!-- Full-Bleed Right Half Section Video Canvas (Spans full right half of the entire section) -->
      <div class="about-section-video-canvas" id="capabilities-video-wrap" aria-hidden="true">
        <!-- Populated via app.js with dynamic background video elements -->
      </div>

      <div class="about-container">
        <!-- Left Column: 1:1 Monolog Story & Ethos Slider -->
        <div class="about-left-col">
          <div class="about-slider-controls">
            <div class="about-slider-progress">
              <div class="slider-progress-bar" id="ethos-progress-bar"></div>
            </div>
            <div class="about-slider-actions">
              <div class="slider-arrows">
                <button class="slider-arrow-btn" id="ethos-prev-btn" aria-label="Previous story">←</button>
                <button class="slider-arrow-btn" id="ethos-next-btn" aria-label="Next story">→</button>
              </div>
              <span class="slider-counter" id="ethos-counter">01/03</span>
            </div>
          </div>

          <div class="about-section-stamp">
            <span class="about-stamp-tag">(PHILOSOPHY & ETHOS)</span>
          </div>

          <!-- Dynamic Stories Container (Populated via app.js) -->
          <div class="about-stories-track" id="about-stories-track">
            <!-- Populated via app.js from data/projects.js -->
          </div>

          <div class="about-author-card">
            <div class="author-avatar-badge">
              <span>L.</span>
            </div>
            <div class="author-meta-info">
              <div class="author-name">Louis</div>
              <div class="author-role">Creative Developer & Builder · Taipei</div>
            </div>
          </div>
        </div>

        <!-- Right Column: Interactive Capabilities Stack -->
        <div class="about-right-col">
          <div class="about-capabilities-header">
            <span class="capabilities-dot">●</span>
            <span class="capabilities-title">What I can help with</span>
          </div>

          <ul class="capabilities-stack-list" id="about-capabilities-list">
            <!-- Populated via app.js from data/projects.js -->
          </ul>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
