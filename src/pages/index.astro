---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);

const allPhotos = await getCollection('photos', ({ data }) => !data.draft);
const latestPhotos = allPhotos.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---

<BaseLayout isHome={true}>
  <main class="main-wrapper">
    <!-- Hero Section (Unified Single-Container Architecture) -->
    <section class="hero-section" id="hero">
      <!-- Layer 1: Warm Paper Canvas Base Background -->
      <div class="hero-paper-bg"></div>

      <!-- Layer 2: Hero Content (Louis. Title with Self-Contained Magnetic Black Hole Dot) -->
      <div class="hero-content-wrap">
        <div class="hero-title-container">
          <h1 class="hero-title-line" id="hero-title-line">
            <span class="js-grav-text">Louis</span>
            <div class="magnetic-wrap" id="hero-magnetic-wrap">
              <div class="js-magnetic-area magnetic-size" id="hero-magnetic-area" title="Click to trigger Black Hole"></div>
              <div class="js-magnetic-content" id="hero-magnetic-content">
                <span class="bh-dot-core" id="hero-title-dot"></span>
                <canvas class="bh-shader-canvas" id="hero-bh-canvas"></canvas>
              </div>
            </div>
          </h1>
        </div>

        <!-- Dictionary Entry Layout (英文字典條目版型 — 方案 5D 口語化三棲宣言) -->
        <div class="hero-dictionary-entry">
          <div class="dict-phonetic-pill">
            <span class="bh-word-particle dict-ipa">/ˈluː.ɪs/</span>
            <span class="bh-word-particle dict-divider">·</span>
            <span class="bh-word-particle dict-pos">n.</span>
          </div>
          <p class="dict-def-en">
            <span class="bh-word-particle">I</span>{' '}
            <span class="bh-word-particle">build</span>{' '}
            <span class="bh-word-particle">digital</span>{' '}
            <span class="bh-word-particle">tools,</span>{' '}
            <span class="bh-word-particle">write</span>{' '}
            <span class="bh-word-particle">about</span>{' '}
            <span class="bh-word-particle">how</span>{' '}
            <span class="bh-word-particle">things</span>{' '}
            <span class="bh-word-particle">work,</span>{' '}
            <span class="bh-word-particle">and</span>{' '}
            <span class="bh-word-particle">take</span>{' '}
            <span class="bh-word-particle">photos</span>{' '}
            <span class="bh-word-particle">along</span>{' '}
            <span class="bh-word-particle">the</span>{' '}
            <span class="bh-word-particle">way.</span>
          </p>
          <p class="dict-def-tw">
            <span class="bh-word-particle">寫點實用的程式</span><span class="bh-word-particle">，</span><span class="bh-word-particle">記下值得深思的想法</span><span class="bh-word-particle">，</span><span class="bh-word-particle">拍點喜歡的風景</span><span class="bh-word-particle">。</span>
          </p>
        </div>
      </div>

      <!-- Horizontal Bottom-Left Editorial Scroll Indicator with Pure DOM Dual-Line Corner -->
      <a href="#works" class="hero-scroll-indicator" id="hero-scroll-indicator" aria-label="Scroll Down to Works">
        <div class="scroll-wrap-box">
          <span class="scroll-text">SCROLL DOWN</span>
          <!-- Pure DOM Dual-Bar Tracks (Pure GPU Compositor) -->
          <div class="corner-bar-top-track">
            <div class="corner-bar-top-fill"></div>
          </div>
          <div class="corner-bar-right-track">
            <div class="corner-bar-right-fill"></div>
          </div>
        </div>
      </a>
    </section>

    <!-- Selected Works / Systems Section (Developer Identity Preview) -->
    <section class="works-section" id="works">
      <header class="home-section-header">
        <div class="section-header-left">
          <div class="section-eyebrow">SYSTEMS &amp; PRODUCTS</div>
          <h2 class="section-title section-heading-split">Featured Works</h2>
        </div>
        <a href="/works/" class="home-section-more-link" data-astro-prefetch="hover">
          <span>VIEW ALL WORKS</span>
          <span>→</span>
        </a>
      </header>

      <!-- Dynamic Stacking Cards Container (Populated via app.js) -->
      <div class="works-cards-wrap" id="works-cards-container">
        <!-- Populated via app.js -->
      </div>
    </section>

    <!-- Curated Section: Recent Writings (Thinker Identity Preview) -->
    <section class="works-section home-curated-section" id="writings">
      <header class="home-section-header">
        <div class="section-header-left">
          <div class="section-eyebrow">THOUGHTS &amp; ESSAYS</div>
          <h2 class="section-title">Recent Writings</h2>
        </div>
        <a href="/blog/" class="home-section-more-link" data-astro-prefetch="hover">
          <span>VIEW ALL ESSAYS</span>
          <span>→</span>
        </a>
      </header>

      <div class="home-writing-list">
        {latestPosts.map((post) => (
          <a href={`/blog/${post.id}/`} class="home-writing-row" data-astro-prefetch="hover">
            <div class="home-writing-left">
              <span class="home-writing-date">{post.data.pubDate.toISOString().slice(0, 10)}</span>
              <h3 class="home-writing-title">{post.data.title}</h3>
            </div>
            <div class="home-writing-right">
              <span class="home-writing-cat">{post.data.category}</span>
              <span class="home-writing-arrow">→</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Curated Section: Recent Snaps (Visual Observer Identity Preview) -->
    <section class="works-section home-curated-section" id="snaps">
      <header class="home-section-header">
        <div class="section-header-left">
          <div class="section-eyebrow">VISUAL JOURNAL</div>
          <h2 class="section-title">Recent Snaps</h2>
        </div>
        <a href="/photos/" class="home-section-more-link" data-astro-prefetch="hover">
          <span>VIEW ALL PHOTOS</span>
          <span>→</span>
        </a>
      </header>

      <div class="home-triptych-grid">
        {latestPhotos.map((photo) => (
          <a href="/photos/" class="home-triptych-item" data-astro-prefetch="hover" aria-label={`View photo: ${photo.data.title}`}>
            <div class="home-triptych-frame">
              <img src={photo.data.photo} alt={photo.data.title} class="home-triptych-img" loading="lazy" />
            </div>
            <div class="home-triptych-meta">
              <span class="home-triptych-location">{photo.data.location}</span>
              <span class="home-triptych-date">{photo.data.pubDate.toISOString().slice(0, 7)}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
