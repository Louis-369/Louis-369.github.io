---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="404 · Signal Lost | Louis." 
  description="Deep space telemetry signal lost. The requested coordinate has collapsed beyond the cosmic event horizon."
>
  <main class="notfound-main-container">
    <div class="notfound-card">
      <div class="stage-radar-grid">
        <!-- Canvas Polar Radar Sweeper -->
        <div class="radar-canvas-wrap">
          <canvas class="radar-canvas-elem" id="radar-canvas"></canvas>
          <div class="radar-overlay-badge">RANGE: 1.0 AU</div>
          <div class="radar-scanner-fx"></div>
        </div>

        <!-- Telemetry Column -->
        <div class="radar-telemetry-col">
          <div class="radar-header-block">
            <span class="telemetry-eyebrow">DEEP SPACE TELEMETRY · RECON-04</span>
            <div class="nf-title-wrap">
              <h1 class="nf-big-num">HTTP 404</h1>
              <span class="radar-status-badge">
                <span class="radar-blip-dot"></span>
                <span>SIGNAL_LOST</span>
              </span>
            </div>
          </div>

          <p class="radar-desc">
            深空脈衝探測儀未截獲有效反射信號。目標空間座標可能處於未坍縮態、已遷移或已被黑洞事件視界吞噬。
          </p>

          <table class="radar-telemetry-table">
            <tbody>
              <tr>
                <td class="radar-label">TARGET COORD</td>
                <td class="radar-val">RA 18h 36m 56s · DEC -36° 27′ 33″ (Sgr A*)</td>
              </tr>
              <tr>
                <td class="radar-label">CARRIER FREQ</td>
                <td class="radar-val">1420.405 MHz (Hydrogen Line)</td>
              </tr>
              <tr>
                <td class="radar-label">PACKET LOSS</td>
                <td class="radar-val is-error">100.0% (0 / 64 packets received)</td>
              </tr>
              <tr>
                <td class="radar-label">STATUS CODE</td>
                <td class="radar-val">404_PAGE_NOT_FOUND · DISCONNECTED</td>
              </tr>
            </tbody>
          </table>

          <!-- Auto Warp Countdown Capsule -->
          <div class="auto-warp-card">
            <div class="auto-warp-meta">
              <span id="auto-warp-label">AUTO-WARP JUMP IN 8.0s</span>
              <span id="auto-warp-pct">100%</span>
            </div>
            <div class="warp-progress-track">
              <div class="warp-progress-fill" id="auto-warp-fill"></div>
            </div>
            <div class="warp-actions-row">
              <button class="nf-escape-btn is-compact" id="warp-pause-btn" type="button">
                ⏸ PAUSE COUNTDOWN
              </button>
              <a href="/" class="nf-escape-btn is-primary" data-astro-prefetch="hover">
                ⚡ WARP TO BASE (立即折躍回首頁)
              </a>
            </div>
          </div>

          <!-- Secondary Navigation Escapes -->
          <div class="nf-subnav-links">
            <span class="subnav-label">OR EXPLORE OTHER SECTORS:</span>
            <a href="/blog/" class="subnav-link" data-astro-prefetch="hover">READ ESSAYS (社論文章) →</a>
            <span class="subnav-divider">·</span>
            <a href="/photos/" class="subnav-link" data-astro-prefetch="hover">PHOTO LOG (攝影切片) →</a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script>
    function setup404Radar() {
      const canvas = document.getElementById('radar-canvas') as HTMLCanvasElement | null;
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      // Handle Retina High-DPI canvas
      const dpr = window.devicePixelRatio || 1;
      const displaySize = 280;
      canvas.width = displaySize * dpr;
      canvas.height = displaySize * dpr;
      canvas.style.width = `${displaySize}px`;
      canvas.style.height = `${displaySize}px`;
      ctx.scale(dpr, dpr);

      const cx = displaySize / 2;
      const cy = displaySize / 2;
      const radius = displaySize / 2 - 12;
      let angle = 0;

      function renderRadar() {
        if (!ctx) return;
        ctx.fillStyle = 'rgba(9, 11, 14, 0.16)';
        ctx.fillRect(0, 0, displaySize, displaySize);

        // Concentric range rings
        ctx.strokeStyle = 'rgba(0, 255, 102, 0.18)';
        ctx.lineWidth = 1;
        for (let r = radius / 4; r <= radius; r += radius / 4) {
          ctx.beginPath();
          ctx.arc(cx, cy, r, 0, Math.PI * 2);
          ctx.stroke();
        }

        // Crosshairs
        ctx.strokeStyle = 'rgba(0, 255, 102, 0.22)';
        ctx.beginPath();
        ctx.moveTo(cx, cy - radius);
        ctx.lineTo(cx, cy + radius);
        ctx.moveTo(cx - radius, cy);
        ctx.lineTo(cx + radius, cy);
        ctx.stroke();

        // Quadrant degree ticks
        ctx.strokeStyle = 'rgba(0, 255, 102, 0.35)';
        for (let a = 0; a < Math.PI * 2; a += Math.PI / 6) {
          const x1 = cx + Math.cos(a) * (radius - 4);
          const y1 = cy + Math.sin(a) * (radius - 4);
          const x2 = cx + Math.cos(a) * radius;
          const y2 = cy + Math.sin(a) * radius;
          ctx.beginPath();
          ctx.moveTo(x1, y1);
          ctx.lineTo(x2, y2);
          ctx.stroke();
        }

        // Sweeping radar beam with trailing decay gradient
        ctx.save();
        ctx.translate(cx, cy);
        ctx.rotate(angle);
        const grad = ctx.createLinearGradient(0, 0, radius, 0);
        grad.addColorStop(0, 'rgba(0, 255, 102, 0.55)');
        grad.addColorStop(0.7, 'rgba(0, 255, 102, 0.25)');
        grad.addColorStop(1, 'rgba(0, 255, 102, 0.0)');
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.arc(0, 0, radius, 0, -0.42, true);
        ctx.closePath();
        ctx.fill();
        ctx.restore();

        // Target Blip (Unreachable signal at 45° angle)
        const targetAngle = Math.PI * 0.25;
        const blipX = cx + Math.cos(targetAngle) * (radius * 0.76);
        const blipY = cy + Math.sin(targetAngle) * (radius * 0.76);
        const diff = Math.abs((angle % (Math.PI * 2)) - targetAngle);
        const intensity = diff < 0.35 ? 1 : Math.max(0.2, 1 - diff * 0.45);

        // Blip outer pulse halo
        if (diff < 0.35) {
          ctx.strokeStyle = `rgba(239, 68, 68, ${intensity * 0.6})`;
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.arc(blipX, blipY, 10 * intensity, 0, Math.PI * 2);
          ctx.stroke();
        }

        // Blip solid core
        ctx.fillStyle = `rgba(239, 68, 68, ${intensity})`;
        ctx.beginPath();
        ctx.arc(blipX, blipY, 4, 0, Math.PI * 2);
        ctx.fill();

        angle += 0.035;
        if (angle > Math.PI * 2) angle -= Math.PI * 2;

        requestAnimationFrame(renderRadar);
      }

      renderRadar();
    }

    function setupAutoWarp() {
      const warpFill = document.getElementById('auto-warp-fill');
      const warpLabel = document.getElementById('auto-warp-label');
      const warpPct = document.getElementById('auto-warp-pct');
      const warpPauseBtn = document.getElementById('warp-pause-btn');
      if (!warpFill || !warpLabel || !warpPct) return;

      const totalTime = 8.0;
      let timeLeft = totalTime;
      let isPaused = false;
      let lastTime = performance.now();

      function tickWarp(now: number) {
        const dt = (now - lastTime) / 1000;
        lastTime = now;

        if (!isPaused && timeLeft > 0) {
          timeLeft = Math.max(0, timeLeft - dt);
          const ratio = timeLeft / totalTime;
          if (warpFill) warpFill.style.transform = `scaleX(${ratio})`;
          if (warpLabel) warpLabel.textContent = `AUTO-WARP JUMP IN ${timeLeft.toFixed(1)}s`;
          if (warpPct) warpPct.textContent = `${Math.round(ratio * 100)}%`;

          if (timeLeft <= 0) {
            if (warpLabel) warpLabel.textContent = 'WARPING TO ORBIT...';
            window.location.href = '/';
            return;
          }
        }

        requestAnimationFrame(tickWarp);
      }

      requestAnimationFrame(tickWarp);

      if (warpPauseBtn) {
        warpPauseBtn.addEventListener('click', () => {
          isPaused = !isPaused;
          warpPauseBtn.textContent = isPaused ? '▶ RESUME COUNTDOWN' : '⏸ PAUSE COUNTDOWN';
          if (warpLabel && isPaused) {
            warpLabel.textContent = `WARP PAUSED (${timeLeft.toFixed(1)}s)`;
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        setup404Radar();
        setupAutoWarp();
      });
    } else {
      setup404Radar();
      setupAutoWarp();
    }
  </script>

  <style>
    .notfound-main-container {
      max-width: 1100px;
      margin: 0 auto;
      padding: clamp(3rem, 7vw, 6rem) 1.5rem 6rem;
      min-height: calc(100vh - 200px);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .notfound-card {
      width: 100%;
      border: 1px solid var(--border-paper, rgba(18, 19, 22, 0.1));
      border-radius: 20px;
      padding: clamp(2rem, 5vw, 4rem);
      background: var(--bg-canvas, #F9F8F5);
      position: relative;
      overflow: hidden;
      box-shadow: 0 4px 24px rgba(18, 19, 22, 0.03);
    }

    .stage-radar-grid {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: clamp(2rem, 4vw, 3.5rem);
      align-items: center;
    }

    @media (max-width: 820px) {
      .stage-radar-grid {
        grid-template-columns: 1fr;
        justify-items: center;
      }
    }

    /* Radar Viewport Housing */
    .radar-canvas-wrap {
      width: 280px;
      height: 280px;
      border-radius: 50%;
      border: 1px solid rgba(18, 19, 22, 0.25);
      position: relative;
      overflow: hidden;
      background: #090B0E;
      box-shadow: inset 0 0 28px rgba(0, 0, 0, 0.85), 0 8px 24px rgba(0, 0, 0, 0.12);
      flex-shrink: 0;
    }

    .radar-canvas-elem {
      width: 100%;
      height: 100%;
      display: block;
    }

    .radar-overlay-badge {
      position: absolute;
      bottom: 12px;
      left: 50%;
      transform: translateX(-50%);
      font-family: var(--font-mono, monospace);
      font-size: 0.65rem;
      letter-spacing: 0.1em;
      color: rgba(0, 255, 102, 0.6);
      background: rgba(9, 11, 14, 0.7);
      padding: 0.15rem 0.5rem;
      border-radius: 999px;
      border: 1px solid rgba(0, 255, 102, 0.2);
      pointer-events: none;
    }

    .radar-scanner-fx {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at center, transparent 65%, rgba(0, 0, 0, 0.6) 100%);
      pointer-events: none;
    }

    /* Telemetry Column */
    .radar-telemetry-col {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      width: 100%;
    }

    .radar-header-block {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .telemetry-eyebrow {
      font-family: var(--font-mono, monospace);
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-muted, #6E6A63);
    }

    .nf-title-wrap {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .nf-big-num {
      font-family: var(--font-serif, serif);
      font-size: clamp(2.6rem, 6vw, 4.2rem);
      font-weight: 700;
      line-height: 1;
      letter-spacing: -0.03em;
      color: var(--ink-primary, #121316);
      margin: 0;
    }

    .radar-status-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-family: var(--font-mono, monospace);
      font-size: 0.76rem;
      letter-spacing: 0.08em;
      color: #EF4444;
      background: rgba(239, 68, 68, 0.08);
      padding: 0.3rem 0.7rem;
      border-radius: 999px;
      border: 1px solid rgba(239, 68, 68, 0.2);
      font-weight: 600;
    }

    .radar-blip-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #EF4444;
      animation: blipGlow 1.4s ease-in-out infinite alternate;
    }

    @keyframes blipGlow {
      0% { opacity: 0.3; transform: scale(0.8); }
      100% { opacity: 1; transform: scale(1.25); }
    }

    .radar-desc {
      font-family: var(--font-tc-serif, serif);
      font-size: clamp(0.96rem, 1.8vw, 1.05rem);
      line-height: 1.7;
      color: var(--ink-secondary, #4A4D55);
      margin: 0;
      max-width: 680px;
    }

    /* Telemetry Table */
    .radar-telemetry-table {
      width: 100%;
      font-family: var(--font-mono, monospace);
      font-size: 0.82rem;
      border-collapse: collapse;
      margin-top: 0.25rem;
    }

    .radar-telemetry-table td {
      padding: 0.45rem 0;
      border-bottom: 1px dashed var(--border-paper, rgba(18, 19, 22, 0.1));
    }

    .radar-label {
      color: var(--ink-muted, #6E6A63);
      width: 36%;
      letter-spacing: 0.04em;
    }

    .radar-val {
      font-weight: 500;
      color: var(--ink-primary, #121316);
      font-variant-numeric: tabular-nums;
    }

    .radar-val.is-error {
      color: #EF4444;
    }

    /* Auto-Warp Capsule */
    .auto-warp-card {
      margin-top: 0.5rem;
      padding: 1.1rem 1.3rem;
      border-radius: 14px;
      background: rgba(18, 19, 22, 0.03);
      border: 1px solid var(--border-paper, rgba(18, 19, 22, 0.1));
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .auto-warp-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: var(--font-mono, monospace);
      font-size: 0.76rem;
      letter-spacing: 0.06em;
      color: var(--ink-secondary, #4A4D55);
      font-variant-numeric: tabular-nums;
    }

    .warp-progress-track {
      width: 100%;
      height: 4px;
      background: rgba(18, 19, 22, 0.1);
      border-radius: 999px;
      overflow: hidden;
    }

    .warp-progress-fill {
      width: 100%;
      height: 100%;
      background: var(--ink-primary, #121316);
      transform-origin: left center;
      transition: transform 0.1s linear;
    }

    .warp-actions-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 0.2rem;
    }

    /* Tactile Neumorphic Buttons */
    .nf-escape-btn {
      color: #090909;
      padding: 0.65em 1.5em;
      font-size: 0.82rem;
      font-family: var(--font-mono, monospace);
      letter-spacing: 0.04em;
      border-radius: 0.6em;
      background: #e8e8e8;
      cursor: pointer;
      border: 1px solid #e8e8e8;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 5px 5px 12px #c5c5c5, -5px -5px 12px #ffffff;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }

    .nf-escape-btn:hover {
      border: 1px solid #FFFFFF;
      transform: translateY(-2px);
      box-shadow: 6px 6px 14px #bcbcbc, -6px -6px 14px #ffffff;
    }

    .nf-escape-btn:active {
      box-shadow: 3px 3px 8px #c5c5c5, -3px -3px 8px #ffffff;
      transform: translateY(0);
    }

    .nf-escape-btn.is-compact {
      font-size: 0.76rem;
      padding: 0.55em 1.1em;
      background: transparent;
      box-shadow: none;
      border: 1px solid var(--border-paper, rgba(18, 19, 22, 0.15));
    }

    .nf-escape-btn.is-compact:hover {
      background: rgba(18, 19, 22, 0.05);
      border-color: var(--ink-primary, #121316);
      box-shadow: none;
    }

    /* Secondary Nav Links */
    .nf-subnav-links {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      flex-wrap: wrap;
      font-family: var(--font-mono, monospace);
      font-size: 0.76rem;
      letter-spacing: 0.04em;
      color: var(--ink-muted, #6E6A63);
      margin-top: 0.5rem;
    }

    .subnav-label {
      opacity: 0.75;
    }

    .subnav-link {
      color: var(--ink-primary, #121316);
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: border-color 0.2s ease;
    }

    .subnav-link:hover {
      border-bottom-color: var(--ink-primary, #121316);
    }

    .subnav-divider {
      opacity: 0.4;
    }

    @media (max-width: 640px) {
      .radar-label {
        width: 44%;
      }
      .warp-actions-row {
        flex-direction: column;
      }
      .nf-escape-btn {
        width: 100%;
        justify-content: center;
      }
    }
  </style>
</BaseLayout>
