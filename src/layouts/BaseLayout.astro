---
import '../styles/style.css';
import '../styles/editorial-blog.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  jsonLd?: Record<string, any>;
  currentNav?: 'works' | 'blog' | 'photos' | 'about';
  isHome?: boolean;
}

const {
  title = "Louis · Creative Developer & Builder",
  description = "Louis · Creative Developer & Builder. High-craft digital tools and interactive web experiences.",
  ogImage = "/assets/works/sunset-park.jpg",
  ogType = "website",
  publishedTime,
  jsonLd,
  currentNav,
  isHome = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const resolvedOgImage = new URL(ogImage, Astro.site);
---

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="description" content={description}>
  <meta name="author" content="Louis">
  <link rel="canonical" href={canonicalURL}>
  <link rel="alternate" type="application/rss+xml" title="Louis · Thoughts & Essays RSS Feed" href={new URL('/rss.xml', Astro.site)}>
  <title>{title}</title>

  <!-- Open Graph / Social Sharing -->
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={resolvedOgImage}>
  {publishedTime && <meta property="article:published_time" content={publishedTime}>}

  <!-- Twitter / X Large Image Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={resolvedOgImage}>

  {jsonLd && (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>✦</text></svg>">

  <!-- Editorial Typography Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&family=Noto+Serif+TC:wght@300;400;500;600;700;900&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet">

  <!-- High-Performance Speculation Rules (Instant 0ms Page Transitions on Hover) -->
  <script is:inline type="speculationrules">
  {
    "prefetch": [
      {
        "source": "document",
        "where": {
          "and": [
            { "href_matches": "/*" },
            { "not": { "href_matches": ["/assets/*", "/_astro/*", "/*\\?(.+)"] } },
            { "not": { "selector_matches": "a[rel~=\"nofollow\"]" } },
            { "not": { "selector_matches": "a[target=\"_blank\"]" } }
          ]
        },
        "eagerness": "moderate"
      }
    ]
  }
  </script>

  <!-- GSAP Core for Micro-interactions & Spoon Easter Egg -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>

  {isHome && (
    <>
      <!-- External Libraries (Lenis, Three.js, ScrollTrigger) for Interactive Experience -->
      <script is:inline src="https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1.0.42/dist/lenis.min.js"></script>
      <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
      <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    </>
  )}
</head>
<body class={isHome ? "is-loading" : "is-subpage"}>
  <!-- Tactile Paper Grain Texture Overlay -->
  <div class="grain-overlay" aria-hidden="true"></div>

  <!-- Persistent Site Navigation (1:1 Monolog Header Architecture) -->
  <header class="site-nav">
    <div class="navbar-brand-wrap">
      <a href="/" class="nav-brand" id="nav-brand-logo" aria-label="Back to top" data-astro-prefetch="hover">
        <span class="nav-brand-text">Louis.</span>
      </a>
    </div>

    <div class="navbar-right-group">
      <!-- Seamless Links Bar (Works + Blog + Photos + About + GitHub) -->
      <ul class="navbar-links-ul">
        <li class="navbar-links-li">
          <a href={isHome ? "#works" : "/#works"} class:list={["navbar-link", { "is-active": currentNav === 'works' }]} data-astro-prefetch="hover">
            <span class="navbar-link-text">Works</span>
          </a>
        </li>
        <li class="navbar-links-li">
          <a href="/blog/" class:list={["navbar-link", { "is-active": currentNav === 'blog' }]} data-astro-prefetch="hover">
            <span class="navbar-link-text">Blog</span>
          </a>
        </li>
        <li class="navbar-links-li">
          <a href="/photos/" class:list={["navbar-link", { "is-active": currentNav === 'photos' }]} data-astro-prefetch="hover">
            <span class="navbar-link-text">Photos</span>
          </a>
        </li>
        <li class="navbar-links-li">
          <a href={isHome ? "#about" : "/#about"} class:list={["navbar-link", { "is-active": currentNav === 'about' }]} data-astro-prefetch="hover">
            <span class="navbar-link-text">About</span>
          </a>
        </li>
        <li class="navbar-links-li">
          <a href="https://github.com/Louis-369" target="_blank" rel="noopener noreferrer" class="navbar-link has-arrow">
            <span class="navbar-link-text">GitHub</span>
            <span class="navbar-arrow-box">
              <svg class="navbar-arrow-svg" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M8.90954 9.09046L9 3L2.90954 3.09046L2.90213 4.32367L6.86437 4.25391L2.55914 8.55914L3.44086 9.44086L7.74609 5.13563L7.68708 9.10862L8.90954 9.09046Z" fill="currentColor"></path>
              </svg>
              <svg class="navbar-arrow-svg is-duplicate" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M8.90954 9.09046L9 3L2.90954 3.09046L2.90213 4.32367L6.86437 4.25391L2.55914 8.55914L3.44086 9.44086L7.74609 5.13563L7.68708 9.10862L8.90954 9.09046Z" fill="currentColor"></path>
              </svg>
            </span>
          </a>
        </li>
      </ul>
    </div>
  </header>

  <!-- Page Content Slot -->
  <slot />

  <!-- Editorial Site Footer (Made by Pan + Louis High-Craft Architecture) -->
  <footer class="site-footer">
    <div class="footer-inner">

      <!-- Layer 1: Consultation & Service Capabilities Card (Dark Tactile Housing) -->
      <div class="footer-consult-card">
        <div class="footer-consult-left">
          <span class="footer-consult-tag">(WHAT I CRAFT & CONSULT)</span>
          <p class="footer-consult-desc">
            創意工程 · 互動著色器與物理模擬 · 高工藝社論排版 · AI 自動化工作流 · 本地 Agent 系統整合
          </p>
          <div class="footer-consult-pills">
            <span class="consult-pill">Creative Engineering</span>
            <span class="consult-pill">Interactive WebGL</span>
            <span class="consult-pill">Editorial Typography</span>
            <span class="consult-pill">AI Workflow Tools</span>
            <span class="consult-pill">Solo Business</span>
          </div>
        </div>
        <div class="footer-consult-right">
          <a href="mailto:contact.louis369@gmail.com" class="footer-consult-btn">
            <span>諮詢合作 Inquiries</span>
            <span class="consult-arrow">→</span>
          </a>
        </div>
      </div>

      <!-- Layer 2: Heroic Brand Wordmark (Made by Pan style, massive Serif Italic "Louis.") -->
      <div class="footer-brand-hero">
        <span class="footer-brand-title">Louis.</span>
      </div>

      <!-- Layer 3: Middle Two-Column Grid (Collaborate & Location/Mission) -->
      <div class="footer-middle-grid">
        <div class="footer-col-collaborate">
          <span class="footer-col-label">COLLABORATE</span>
          <a href="mailto:contact.louis369@gmail.com" class="footer-email-link">
            contact.louis369@gmail.com
          </a>
        </div>
        <div class="footer-col-mission">
          <span class="footer-col-label">TAIPEI / REMOTE</span>
          <p class="footer-mission-text">
            以工程之嚴謹鑄造系統，以編排之美感傳遞溫度。專注於現代客戶端速度、流體物理模擬與歷久彌新的數位工藝。
          </p>
        </div>
      </div>

      <hr class="footer-hairline" />

      <!-- Layer 4: Bottom Bar (Socials Left, Spoon Easter Egg Center, Copyright Right) -->
      <div class="footer-bottom-row">
        <div class="footer-social-links">
          <a href="https://github.com/Louis-369" target="_blank" rel="noopener noreferrer" class="footer-social-link">GitHub</a>
          <span class="footer-social-dot">·</span>
          <a href="/blog/" class="footer-social-link" data-astro-prefetch="hover">Blog</a>
          <span class="footer-social-dot">·</span>
          <a href="/photos/" class="footer-social-link" data-astro-prefetch="hover">Photos</a>
          <span class="footer-social-dot">·</span>
          <a href="/rss.xml" target="_blank" rel="noopener noreferrer" class="footer-social-link">RSS ↗</a>
        </div>
        
        <!-- Psychic Silver Spoon Easter Egg Trigger -->
        <div class="footer-spoon-easter-egg" id="footer-spoon-trigger" role="button" tabindex="0" aria-label="There is no spoon">
          <span class="spoon-tooltip">There is no spoon.</span>
          <svg class="spoon-svg" id="spoon-svg-elem" viewBox="0 0 50 50" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="spoonBowlGrad" x1="16" y1="4" x2="34" y2="18" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#121316"/>
                <stop offset="60%" stop-color="#2D3039"/>
                <stop offset="100%" stop-color="#121316"/>
              </linearGradient>
              <linearGradient id="spoonCavityGrad" x1="18" y1="5" x2="30" y2="16" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#0F1013"/>
                <stop offset="40%" stop-color="#4A5568"/>
                <stop offset="100%" stop-color="#CBD5E1"/>
              </linearGradient>
            </defs>
            <g id="spoon-group" transform="rotate(-45 25 25)">
              <ellipse cx="25" cy="11.5" rx="7.5" ry="9.5" fill="url(#spoonBowlGrad)"/>
              <ellipse cx="25" cy="11.5" rx="5.8" ry="7.8" fill="url(#spoonCavityGrad)"/>
              <path d="M 19.8 11.5 C 19.8 7.5, 22 4.5, 25 4.5 C 28 4.5, 30.2 7.5, 30.2 11.5" stroke="#FFFFFF" stroke-width="0.8" opacity="0.65" stroke-linecap="round" fill="none"/>
              <path id="spoon-handle-path" d="M 25 19.5 Q 25 31.5 25 44" stroke="#121316" stroke-width="2.6" stroke-linecap="round"/>
              <circle cx="25" cy="43.5" r="1.6" fill="#121316"/>
            </g>
          </svg>
        </div>

        <div class="footer-copyright-text">
          <span>© 2026 LOUIS · ALL RIGHTS RESERVED</span>
        </div>
      </div>
    </div>
  </footer>

  <!-- Matrix Digital Rain Easter Egg Overlay -->
  <div class="matrix-overlay" id="matrix-overlay" aria-hidden="true">
    <canvas id="matrix-canvas" class="matrix-canvas"></canvas>
    <div class="matrix-typewriter-wrap" id="matrix-typewriter-wrap">
      <span class="typewriter-text" id="typewriter-text"></span><span class="typewriter-cursor" id="typewriter-cursor">_</span>
    </div>
    <div class="matrix-hud-top">
      <button class="ui-btn" id="matrix-exit-btn" aria-label="Exit Matrix Mode">
        <span>EXIT</span>
      </button>
    </div>
    <div class="matrix-hud-bottom">
      <p class="matrix-hud-quote">"Do not try and bend the spoon. That's impossible. Instead... only try to realize the truth."</p>
    </div>
  </div>

  <!-- Universal Psychic Silver Spoon & Matrix Easter Egg -->
  <script is:inline type="module" src="/spoon-easter-egg.js?v=20261103_1530"></script>

  {isHome && (
    <script is:inline type="module" src="/app.js?v=20261030_0052"></script>
  )}
</body>
</html>
